# StockPilot backend — copy to `.env` and fill in.

DATABASE_URL=postgresql://user:password@localhost:5432/stockpilot
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMS gateway integration — leave disabled unless you have a Hubtel/Arkesel account.
SMS_ENABLED=false
SMS_PROVIDER=hubtel
