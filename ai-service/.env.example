# StockPilot AI service — copy to `.env` and fill in your values.
#
# Roboflow hosted inference: sign up at https://roboflow.com, then:
#   1. Choose a model from https://universe.roboflow.com (search for the
#      domain you care about, e.g. "cement bag", "bricks", "rebar"), or
#      train your own.
#   2. The model identifier follows the pattern  workspace/project/version,
#      e.g. "cement-bag-counter/cement-bag/2"
#   3. Copy your private API key from  Settings → API Keys.
#
# If both values are left blank the service runs in placeholder mode so the
# frontend remains usable during local development.

ROBOFLOW_API_KEY=
ROBOFLOW_MODEL=

# Minimum prediction confidence (0.0 – 1.0) to keep in the response.
CONFIDENCE_THRESHOLD=0.35
